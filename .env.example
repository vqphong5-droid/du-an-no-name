# Port server lắng nghe (mặc định 3000)
PORT=3000

# Resend API Key để gửi email tự động từ domain riêng
RESEND_API_KEY=re_your_api_key_here

# (Tùy chọn) Cấu hình Turso Cloud SQLite Database nếu deploy serverless hoặc cần cloud db
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Google Apps Script Web App URLs để ẩn secrets ở front-end
GOOGLE_SCRIPT_SEPAY_URL=https://script.google.com/macros/s/xxxx/exec
GOOGLE_SCRIPT_SURVEY_URL=https://script.google.com/macros/s/yyyy/exec
